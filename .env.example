# Copy this file to .env and adjust values for your environment.
# Never commit the real .env file.

ENVIRONMENT=development

# --- Postgres (used by docker-compose and the backend) ---
POSTGRES_USER=thinkdesk
POSTGRES_PASSWORD=thinkdesk
POSTGRES_DB=thinkdesk
POSTGRES_PORT=5432

# --- Backend ---
DATABASE_URL=postgresql+asyncpg://thinkdesk:thinkdesk@postgres:5432/thinkdesk
API_PORT=8000
CORS_ORIGINS=http://localhost:3000

# Optional: free key at https://console.groq.com. Without it, chat still
# retrieves and cites sources but returns a "not configured" message
# instead of a generated answer.
GROQ_API_KEY=

# --- Frontend ---
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000
