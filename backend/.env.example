# Local (non-Docker) backend override.
# Copy to backend/.env for local development against a locally installed Postgres.
DATABASE_URL=postgresql+asyncpg://thinkdesk:thinkdesk@localhost:5432/thinkdesk
CORS_ORIGINS=http://localhost:3000

# Optional: without this, chat generation returns a clear "not configured"
# message instead of an answer, but retrieval/citations still work.
# Free key: https://console.groq.com
GROQ_API_KEY=

# Optional: Gmail connector (Phase 7). Create an OAuth client (Web
# application type) in Google Cloud Console -- see docs/setup.md.
# Without these, the connector routes return a clear "not configured" error.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/connectors/google/callback

# Required for any connector to work: encrypts OAuth tokens at rest.
# Generate once with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CONNECTOR_ENCRYPTION_KEY=

# Optional: Lemon Squeezy billing (Phase 8) -- a Merchant of Record, usable
# without a Stripe-supported home country. API key from Settings > API in
# the dashboard; store ID from GET https://api.lemonsqueezy.com/v1/stores.
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=
